{
  "name": "filinglens",
  "main": "cf/worker.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "filinglens", "database_id": "1125ef53-a142-41a0-ab97-4f91291c0c7c" }],
  "browser": { "binding": "BROWSER" },
  "triggers": { "crons": ["0 3 * * *"] },
  "vars": { "STORAGE_READY": "1" },
  "alias": {
    "@vercel/blob": "./cf/blob.ts",
    "puppeteer-core": "./cf/empty.ts",
    "@sparticuz/chromium": "./cf/empty.ts"
  },
  "observability": { "enabled": true }
}
