{
  "functions": {
    "api/host.ts": {
      "includeFiles": "backend/**",
      "maxDuration": 60
    },
    "api/batch.ts": {
      "maxDuration": 60
    },
    "api/marketcap.ts": {
      "maxDuration": 30
    },
    "api/yahoo.ts": {
      "maxDuration": 60,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    }
  },
  "crons": [
    {
      "path": "/api/prices?cleanup=1",
      "schedule": "0 3 * * *"
    }
  ]
}